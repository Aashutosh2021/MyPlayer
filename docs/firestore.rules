rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// MyPlayer site — Firestore rules
//
// Model:
//   - ANY visitor may CREATE an event doc (visit / download tracking).
//   - NOBODY (not even signed-in users) may read, edit or delete events
//     from the client — only the Firebase Console (owner) can.
//     The admin dashboard is exempt via the admin() check below.
//   - All other collections: locked.
//
// Deploy:  firebase deploy --only firestore:rules
// (or paste into Console → Firestore → Rules)
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    match /events/{eventId} {
      // Visitors can only add new events, never read or tamper with them.
      allow create: if true;
      // Signed-in admins (Firebase Auth) may read for the dashboard.
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
